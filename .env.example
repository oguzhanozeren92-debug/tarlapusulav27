# TarlaPusula social auth / OAuth
# Provider buttons are normally discovered live from Supabase /auth/v1/settings.
# This Apple flag is only a safe fallback when that settings request is unavailable.
VITE_APPLE_SIGN_IN_ENABLED=false
# Canonical public HTTPS bridge used by native OAuth before returning to
# com.tarlapusula.app://auth-callback.
VITE_PUBLIC_APP_URL=https://tarlapusulav27.vercel.app/

# TarlaPusula native store subscriptions
# RevenueCat public SDK keys; these are intended to ship in the mobile app.
VITE_REVENUECAT_IOS_PUBLIC_KEY=
VITE_REVENUECAT_ANDROID_PUBLIC_KEY=

# Optional web-only fallback labels. Native builds always read localized prices
# from App Store / Google Play via RevenueCat.
VITE_PLUS_MONTHLY_PRICE="₺200 / ay"
VITE_PLUS_YEARLY_PRICE="₺1.920 / yıl"
VITE_PREMIUM_MONTHLY_PRICE="₺250 / ay"
VITE_PREMIUM_YEARLY_PRICE="₺2.400 / yıl"


# TarlaPusula AdMob ad units
# DEV builds always use Google's demo units. Production uses these IDs when present.
VITE_ADMOB_TEST_MODE=true
VITE_ADMOB_ANDROID_REWARDED_ID=
VITE_ADMOB_ANDROID_INTERSTITIAL_ID=
VITE_ADMOB_IOS_REWARDED_ID=
VITE_ADMOB_IOS_INTERSTITIAL_ID=

# PUSULAPDF footer / mobile download QR targets.
# Store listing URLs should replace the web fallback as soon as the apps are public.
VITE_ANDROID_DOWNLOAD_URL=
VITE_IOS_DOWNLOAD_URL=
