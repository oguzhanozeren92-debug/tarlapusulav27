# TarlaPusula native store subscriptions
# RevenueCat public SDK keys; these are intended to ship in the mobile app.
VITE_REVENUECAT_IOS_PUBLIC_KEY=
VITE_REVENUECAT_ANDROID_PUBLIC_KEY=

# Optional web-only fallback labels. Native builds always read localized prices
# from App Store / Google Play via RevenueCat.
VITE_PLUS_MONTHLY_PRICE=
VITE_PLUS_YEARLY_PRICE=
VITE_PREMIUM_MONTHLY_PRICE=
VITE_PREMIUM_YEARLY_PRICE=
